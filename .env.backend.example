# =============================================================================
# DTF Commune de Benslimane - Configuration BACKEND (Node.js / Express / MySQL)
# Déploiement : Render / Railway / Hostinger / VPS
# =============================================================================

# -----------------------------------------------------------------------------
# Configuration Serveur Express
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Clé secrète robuste pour signer et vérifier les tokens JWT
JWT_SECRET=dtf_benslimane_super_secret_jwt_key_2026_prod

# -----------------------------------------------------------------------------
# Configuration CORS & Sécurité
# -----------------------------------------------------------------------------
# URL de production de votre frontend (Netlify, Vercel, ou nom de domaine personnalisé)
FRONTEND_URL=https://dtf-benslimane.netlify.app

# (Optionnel) Liste d'origines autorisées additionnelles séparées par des virgules
# ALLOWED_ORIGINS=https://dtf-benslimane.netlify.app,https://dtf-benslimane.vercel.app

# -----------------------------------------------------------------------------
# Base de Données MySQL (Option A : Connection URI - Recommandé pour Aiven / Railway / TiDB Cloud)
# Si cette variable est renseignée, elle sera utilisée en priorité avec SSL activé automatiquement.
# -----------------------------------------------------------------------------
# Exemple Aiven / Railway : mysql://avnadmin:mon_mot_de_passe@mysql-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=

# -----------------------------------------------------------------------------
# Base de Données MySQL (Option B : Variables séparées si DATABASE_URL n'est pas utilisé)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dtf_benslimane

# SSL pour la base de données (true par défaut sur le cloud, false pour désactiver explicitement)
DB_SSL=true

# Tentative de création auto de la base (uniquement utile en local avec utilisateur root)
AUTO_CREATE_DB=false
