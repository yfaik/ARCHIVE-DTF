# =============================================================================
# DTF Commune de Benslimane - Guide Global des Variables d'Environnement
# =============================================================================
# Ce fichier recense toutes les variables pour le Frontend et le Backend.
# Pour les fichiers spécifiques par service :
# - Frontend : voir .env.frontend.example
# - Backend  : voir .env.backend.example
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND (À configurer dans Netlify / Vercel)
# -----------------------------------------------------------------------------
# URL de votre API backend en production (Render, Railway, etc.)
VITE_API_URL=https://dtf-backend.onrender.com/api

# -----------------------------------------------------------------------------
# 2. BACKEND (À configurer dans Render / Railway)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=dtf_benslimane_super_secret_jwt_key_2026_prod

# URL de votre frontend en production (pour autoriser les requêtes CORS)
FRONTEND_URL=https://dtf-benslimane.netlify.app

# -----------------------------------------------------------------------------
# 3. BASE DE DONNÉES MySQL (À configurer dans Render / Railway)
# -----------------------------------------------------------------------------
# Option A : URL complète (Fournie directement par Aiven, Railway ou TiDB Cloud)
# DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED

# Option B : Paramètres individuels (si DATABASE_URL n'est pas utilisé)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dtf_benslimane
DB_SSL=true
