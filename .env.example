# =============================================================================
# DTF Commune de Benslimane - Guide Global des Variables d'Environnement
# Compatible Vercel + Neon Tech (PostgreSQL Serverless)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND (Optionnel sur Vercel : si hébergé sur le même domaine, laissez vide)
# -----------------------------------------------------------------------------
# Si le backend et le frontend sont sur le même domaine Vercel, VITE_API_URL=/api est automatique
# VITE_API_URL=https://votre-projet.vercel.app/api

# -----------------------------------------------------------------------------
# 2. BACKEND & SÉCURITÉ
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=dtf_benslimane_super_secret_jwt_key_2026_prod

# -----------------------------------------------------------------------------
# 3. BASE DE DONNÉES POSTGRESQL (Neon Tech)
# -----------------------------------------------------------------------------
# Récupérez votre URL de connexion sur https://console.neon.tech :
DATABASE_URL=postgresql://neondb_owner:votre_mot_de_passe@ep-nom-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
