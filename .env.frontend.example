# URL complète de l'API Backend hébergée (Render, Railway, etc.)
# IMPORTANT : Le code gère automatiquement la présence ou l'absence du suffixe /api.
# 
# Exemple Render  : https://dtf-backend.onrender.com/api
# Exemple Railway : https://dtf-backend.up.railway.app/api
# Exemple Local   : http://localhost:5000/api
VITE_API_URL=https://dtf-backend.onrender.com/api

# Optionnel (Développement uniquement) : Cible du proxy local Vite
# VITE_DEV_BACKEND_URL=http://localhost:5000
